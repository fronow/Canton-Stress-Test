{
  "_comment": [
    "Canton Coin (Amulet) transfer completed through the receiver's TransferPreapproval,",
    "with a featured-app right, as MainNet wallets submit it. Generated by gen-amulet-preapproved.cjs."
  ],
  "version": 1,
  "parties": 6,
  "roles": [
    "admin"
  ],
  "setup": [
    {
      "_comment": "The registry's factory. Its template and fields are implementation-specific.",
      "id": "factory",
      "disclose": true,
      "actAs": [
        "$role:admin"
      ],
      "op": {
        "kind": "create",
        "template": "#splice-amulet:Splice.ExternalPartyAmuletRules:ExternalPartyAmuletRules",
        "args": {
          "dso": "$role:admin"
        }
      }
    },
    {
      "_comment": "The DSO's ExternalPartyConfigState, which every Amulet transfer reads from its context.",
      "id": "config",
      "disclose": true,
      "actAs": [
        "$role:admin"
      ],
      "op": {
        "kind": "create",
        "template": "#splice-amulet:Splice.ExternalPartyConfigState:ExternalPartyConfigState",
        "args": {
          "dso": "$role:admin",
          "holdingFeesOpenRoundNumber": {
            "number": 0
          },
          "amuletPrice": "1.0",
          "transferConfig": {
            "holdingFee": {
              "rate": "0.0"
            },
            "maxNumInputs": 100,
            "maxNumOutputs": 100,
            "maxNumLockHolders": 50,
            "tokenStandardMaxTTL": null
          },
          "targetArchiveAfter": "$now+1h",
          "rewardCalculationVersion": null,
          "amuletSwitchOverTimes": null
        }
      }
    },
    {
      "_comment": "The sending wallet's holdings. One per measured transfer, so a transfer normally has its own input to spend.",
      "id": "holdings",
      "count": 60,
      "actAs": [
        "$role:admin",
        "$p0"
      ],
      "op": {
        "kind": "create",
        "template": "#splice-amulet:Splice.Amulet:Amulet",
        "args": {
          "dso": "$role:admin",
          "owner": "$p0",
          "amount": {
            "initialAmount": "1000.0",
            "createdAt": {
              "number": 0
            },
            "ratePerRound": {
              "rate": "0.0"
            }
          }
        }
      }
    },
    {
      "_comment": "The provider's FeaturedAppRight (signed by the DSO), read from the transfer's context.",
      "id": "featured",
      "disclose": true,
      "actAs": [
        "$role:admin"
      ],
      "op": {
        "kind": "create",
        "template": "#splice-amulet:Splice.Amulet:FeaturedAppRight",
        "args": {
          "dso": "$role:admin",
          "provider": "$p2"
        }
      }
    },
    {
      "_comment": "The receiver's TransferPreapproval, signed by the receiver, the provider and the DSO.",
      "id": "preapproval",
      "disclose": true,
      "actAs": [
        "$role:admin",
        "$p1",
        "$p2"
      ],
      "op": {
        "kind": "create",
        "template": "#splice-amulet:Splice.AmuletRules:TransferPreapproval",
        "args": {
          "dso": "$role:admin",
          "receiver": "$p1",
          "provider": "$p2",
          "validFrom": "$now-60s",
          "lastRenewedAt": "$now-60s",
          "expiresAt": "$now+24h"
        }
      }
    }
  ],
  "operations": [
    {
      "weight": 1,
      "_comment": "The standard transfer — identical for every conforming registry.",
      "op": {
        "kind": "exercise",
        "template": "#splice-api-token-transfer-instruction-v1:Splice.Api.Token.TransferInstructionV1:TransferFactory",
        "contract": "$ref:factory",
        "choice": "TransferFactory_Transfer",
        "args": {
          "expectedAdmin": "$role:admin",
          "transfer": {
            "sender": "$p0",
            "receiver": "$p1",
            "amount": "1.0",
            "instrumentId": {
              "admin": "$role:admin",
              "id": "Amulet"
            },
            "requestedAt": "$now-60s",
            "executeBefore": "$now+1h",
            "inputHoldingCids": [
              "$ref:holdings[*]"
            ],
            "meta": {
              "values": {}
            }
          },
          "extraArgs": {
            "context": {
              "values": {
                "transfer-preapproval": {
                  "tag": "AV_ContractId",
                  "value": "$ref:preapproval"
                },
                "open-round": {
                  "tag": "AV_ContractId",
                  "value": "$ref:config"
                },
                "external-party-config-state": {
                  "tag": "AV_ContractId",
                  "value": "$ref:config"
                },
                "amulet-rules": {
                  "tag": "AV_ContractId",
                  "value": "$ref:config"
                },
                "featured-app-right": {
                  "tag": "AV_ContractId",
                  "value": "$ref:featured"
                }
              }
            },
            "meta": {
              "values": {}
            }
          }
        }
      },
      "submit": {
        "actAs": [
          "$p0"
        ]
      }
    }
  ]
}
