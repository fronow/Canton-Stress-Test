{
  "_comment": [
    "Canton Coin (Amulet) two-step transfer, second step: the receiver accepts the offer.",
    "Generated by gen-amulet-accept.cjs."
  ],
  "version": 1,
  "parties": 6,
  "roles": [
    "admin"
  ],
  "setup": [
    {
      "_comment": "The registry's factory. Its template and fields are implementation-specific.",
      "id": "factory",
      "disclose": true,
      "actAs": [
        "$role:admin"
      ],
      "op": {
        "kind": "create",
        "template": "#splice-amulet:Splice.ExternalPartyAmuletRules:ExternalPartyAmuletRules",
        "args": {
          "dso": "$role:admin"
        }
      }
    },
    {
      "_comment": "The DSO's ExternalPartyConfigState, which every Amulet transfer reads from its context.",
      "id": "config",
      "disclose": true,
      "actAs": [
        "$role:admin"
      ],
      "op": {
        "kind": "create",
        "template": "#splice-amulet:Splice.ExternalPartyConfigState:ExternalPartyConfigState",
        "args": {
          "dso": "$role:admin",
          "holdingFeesOpenRoundNumber": {
            "number": 0
          },
          "amuletPrice": "1.0",
          "transferConfig": {
            "holdingFee": {
              "rate": "0.0"
            },
            "maxNumInputs": 100,
            "maxNumOutputs": 100,
            "maxNumLockHolders": 50,
            "tokenStandardMaxTTL": null
          },
          "targetArchiveAfter": "$now+1h",
          "rewardCalculationVersion": null,
          "amuletSwitchOverTimes": null
        }
      }
    },
    {
      "_comment": "The sending wallet's holdings. One per measured transfer, so a transfer normally has its own input to spend.",
      "id": "holdings",
      "count": 60,
      "actAs": [
        "$role:admin",
        "$p0"
      ],
      "op": {
        "kind": "create",
        "template": "#splice-amulet:Splice.Amulet:Amulet",
        "args": {
          "dso": "$role:admin",
          "owner": "$p0",
          "amount": {
            "initialAmount": "1000.0",
            "createdAt": {
              "number": 0
            },
            "ratePerRound": {
              "rate": "0.0"
            }
          }
        }
      }
    },
    {
      "_comment": "One offer per holding: the measured transfer of amulet-transfer.json, run in setup.",
      "id": "offers",
      "count": 60,
      "actAs": [
        "$p0"
      ],
      "readAs": [
        "$role:admin"
      ],
      "bind": "AmuletTransferInstruction",
      "op": {
        "kind": "exercise",
        "template": "#splice-api-token-transfer-instruction-v1:Splice.Api.Token.TransferInstructionV1:TransferFactory",
        "contract": "$ref:factory",
        "choice": "TransferFactory_Transfer",
        "args": {
          "expectedAdmin": "$role:admin",
          "transfer": {
            "sender": "$p0",
            "receiver": "$p1",
            "amount": "1.0",
            "instrumentId": {
              "admin": "$role:admin",
              "id": "Amulet"
            },
            "requestedAt": "$now-60s",
            "executeBefore": "$now+1h",
            "inputHoldingCids": [
              "$ref:holdings[$i]"
            ],
            "meta": {
              "values": {}
            }
          },
          "extraArgs": {
            "context": {
              "values": {
                "external-party-config-state": {
                  "tag": "AV_ContractId",
                  "value": "$ref:config"
                }
              }
            },
            "meta": {
              "values": {}
            }
          }
        }
      }
    }
  ],
  "operations": [
    {
      "weight": 1,
      "_comment": "The receiver accepts the next unused offer.",
      "op": {
        "kind": "exercise",
        "template": "#splice-api-token-transfer-instruction-v1:Splice.Api.Token.TransferInstructionV1:TransferInstruction",
        "contract": "$ref:offers[seq]",
        "choice": "TransferInstruction_Accept",
        "args": {
          "extraArgs": {
            "context": {
              "values": {
                "external-party-config-state": {
                  "tag": "AV_ContractId",
                  "value": "$ref:config"
                }
              }
            },
            "meta": {
              "values": {}
            }
          }
        }
      },
      "submit": {
        "actAs": [
          "$p1"
        ],
        "readAs": [
          "$p0"
        ]
      }
    }
  ]
}
