// Create a party hosted on participant1 (Submission, so canton-stress can sign
// setup for it there) plus the participants listed in EXTRA (Confirmation),
// threshold 1. Each extra host then receives and confirms every transaction the
// party is a signatory of. Generated by run-cosign.sh; prints "PARTY=<id>".
import com.digitalasset.canton.topology.transaction.ParticipantPermission
import com.digitalasset.canton.config.RequireTypes.PositiveInt
import com.digitalasset.canton.config.NonNegativeDuration

val NAME = "__NAME__"
val EXTRA: Seq[Int] = Seq(__EXTRA__)
val byNum = participants.all.map(p => p.name.stripPrefix("participant").toInt -> p).toMap
val hosts = participant1 +: EXTRA.map(byNum)
val sync = sequencer1.synchronizer_id
val party = participant1.parties.enable(s"$NAME-${System.currentTimeMillis}", synchronizeParticipants = hosts)
if (EXTRA.nonEmpty) {
  val perms = hosts.zipWithIndex.map { case (p, i) =>
    (p.id, if (i == 0) ParticipantPermission.Submission else ParticipantPermission.Confirmation)
  }
  hosts.foreach(p => p.topology.party_to_participant_mappings.propose(party, perms, threshold = PositiveInt.one, store = sync))
  utils.retry_until_true(NonNegativeDuration.tryFromDuration(scala.concurrent.duration.Duration("60s"))) {
    hosts.forall(h => h.topology.party_to_participant_mappings.is_known(sync, party, hosts.map(_.id), None, Some(PositiveInt.one)))
  }
}
println("PARTY=" + party.toProtoPrimitive)
